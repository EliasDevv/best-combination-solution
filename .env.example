# Copy to .env and fill in values. All variables are read by
# backend/config/settings/; none are required for pure-SQLite development.

# Django (DEBUG is not an env var: it is on in config.settings.dev,
# off in config.settings.prod — pick the module, not the flag)
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Read by config.settings.prod only; set to 0 to disable the HTTPS redirect
# (e.g. behind a proxy that already terminates TLS). Defaults to 1.
DJANGO_SSL_REDIRECT=1

# PostgreSQL (leave POSTGRES_HOST empty/unset to fall back to SQLite)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=best_combination
POSTGRES_USER=best_combination
POSTGRES_PASSWORD=

# Redis (prod cache backend only)
REDIS_URL=redis://localhost:6379/0
